<?php

/**
 * @file
 * Anti Knock module helper functions and theme hooks.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\anti_knock\Hook\AntiKnockHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function anti_knock_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(AntiKnockHooks::class)->help($route_name, $route_match);
}
